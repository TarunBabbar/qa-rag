# QABuddy configuration. Copy to `.env` and fill in the keys.

# ---- embeddings (OpenRouter, HTTP) ----
# openrouter | openai (any OpenAI-compatible root) | ollama
EMBED_PROVIDER=openrouter
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
# Qwen3-Embedding, 4B, Matryoshka-truncated to 1024-d (keeps nearly all the quality)
EMBED_MODEL=qwen/qwen3-embedding-4b
EMBED_DIM=1024

# ---- vector DB (Pinecone serverless; dense + sparse in one index) ----
# The index is created automatically on first ingest (dotproduct, EMBED_DIM, aws/us-east-1).
PINECONE_API_KEY=
PINECONE_INDEX=qabuddy
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# PINECONE_HOST=            # set to target an existing index by host instead of name

# ---- reranker ----
# jina (hosted, works on Vercel) | local (sentence-transformers) | none
# `jina` without JINA_API_KEY automatically falls back to `none`.
RERANK_PROVIDER=jina
JINA_API_KEY=
RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3

# ---- answer LLM (OpenRouter free model) ----
# openrouter | groq | openai | ollama
LLM_PROVIDER=openrouter
# comma-separated fallback list; free slugs rotate, check https://openrouter.ai/models?max_price=0
LLM_MODEL=inclusionai/ling-3.0-flash-sante:free,cohere/north-mini-code:free,qwen/qwen3.8-27b:free,dots-studio/dots-3-note-preview:free
OPENROUTER_API_KEY=
# Free reasoning models can spend the whole completion budget on hidden reasoning
# and stream no answer at all. This caps it so content always gets tokens (0 = off).
LLM_REASONING_MAX_TOKENS=800

# ---- retrieval knobs ----
PREFETCH_K=40
RERANK_CANDIDATES=24
FINAL_K=6
CONTEXT_TOKENS=3500

# ---- JIRA (REST + JQL sync into data/01_JIRA_Tickets; optional) ----
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=project = VWO ORDER BY updated DESC

# ---- server ----
PORT=8300
